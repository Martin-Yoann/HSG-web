# Public production origin used by shared metadata.
NEXT_PUBLIC_SITE_URL=https://happyglobalinc.com

# Server-only mail credentials. Configure in Vercel and redeploy; never use NEXT_PUBLIC_.
CONTACT_MAIL_PROVIDER=smtp
CONTACT_MAIL_FROM=service@happyglobalinc.com
CONTACT_MAIL_TO=service@happyglobalinc.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Alternative: CONTACT_MAIL_PROVIDER=resend, verified CONTACT_MAIL_FROM, and this key.
RESEND_API_KEY=
